VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxx
# Legacy fallback accepted by the app; prefer the publishable key above.
# VITE_SUPABASE_ANON_KEY=YOUR_LEGACY_ANON_KEY

# Server-only. Prefer SUPABASE_SECRET_KEY for new Supabase projects.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxx
# Legacy fallback accepted by the server helper.
# SUPABASE_SERVICE_ROLE_KEY=YOUR_LEGACY_SERVICE_ROLE_KEY

# Optional server-side R2 adapter values; never expose these as VITE_* variables.
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_BUCKET_NAME=pagina-inteligente-assets
R2_PUBLIC_BASE_URL=https://assets.example.com
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_KEY
